# Application
APP_NAME=EEG-XAI
APP_ENV=development
DEBUG=true

# Database (PostgreSQL em produção; SQLite em testes)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/eeg_xai

# Storage (caminhos absolutos no servidor)
STORAGE_ROOT=C:/Users/Foco/Documents/DEV/eeg-xai/storage
EDF_STORAGE_PATH=C:/Users/Foco/Documents/DEV/eeg-xai/storage/edf
SHAP_STORAGE_PATH=C:/Users/Foco/Documents/DEV/eeg-xai/storage/shap

# Modelo CNN-LSTM híbrido (fluxo legado)
KERAS_MODEL_PATH=C:/Users/Foco/Documents/DEV/eeg-xai/modelos/cnn_lstm_hybrid.keras

# Duração máxima do EDF para IA e visualização (segundos).
# Deixe vazio para analisar o arquivo inteiro; ex: 120 limita aos primeiros 2 minutos.
MAX_EDF_DURATION_SECONDS=

# ---------------------------------------------------------------------------
# Modelo CNN-LSTM SEQUENCIAL (global / inter-paciente)
# ---------------------------------------------------------------------------
# AI_MODEL_TYPE=legacy            -> usa o modelo híbrido por janela (padrão)
# AI_MODEL_TYPE=sequence_cnn_lstm -> usa o modelo sequencial global
# Se o modelo sequencial não existir, a aplicação faz fallback automático
# para o fluxo legado sem quebrar.
AI_MODEL_TYPE=legacy

# Artefatos do modelo sequencial. Scaler/metadata/calibração podem ficar
# vazios para serem derivados automaticamente a partir do caminho do modelo:
#   <modelo>.keras  ->  <modelo>_scaler.pkl / <modelo>_metadata.json
AI_SEQUENCE_MODEL_PATH=C:/Users/Foco/Documents/DEV/eeg-xai/modelos/sequence_cnn_lstm_features.keras
AI_SEQUENCE_SCALER_PATH=
AI_SEQUENCE_METADATA_PATH=
AI_SEQUENCE_CALIBRATION_PATH=C:/Users/Foco/Documents/DEV/eeg-xai/modelos/calibration_sequence_cnn_lstm_chb11.json

# Regra de decisão por trecho contínuo suspeito.
# Usados quando não houver calibração; a calibração (best_aligned/best) tem prioridade.
AI_SEQUENCE_DEFAULT_THRESHOLD=0.5
AI_SEQUENCE_DEFAULT_MIN_DURATION_SECONDS=30
AI_SEQUENCE_TOP_SEGMENTS_LIMIT=5
AI_SEQUENCE_MAX_SUSPICIOUS_COVERAGE=0.7
# Na aplicacao, o threshold configurado no perfil medico substitui o threshold
# do arquivo de calibracao. Use esse ajuste como override clinico auditavel.

# JWT
JWT_SECRET_KEY=troque-esta-chave-em-producao-eeg-xai
JWT_EXPIRE_MINUTES=480
